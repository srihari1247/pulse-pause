{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:desktop": "npm run build:desktop && electron apps/desktop",
    "build": "vite build",
    "build:web": "vite build",
    "build:desktop": "esbuild apps/desktop/src/main/main.ts --bundle --platform=node --target=node20 --outfile=apps/desktop/dist/main/main.js --external:electron --external:@smartspectra/node-sdk && esbuild apps/desktop/src/preload/preload.ts --bundle --platform=node --target=node20 --outfile=apps/desktop/dist/preload/preload.js --external:electron",
    "build:all": "npm run build:web && npm run build:desktop",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^2.15.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
