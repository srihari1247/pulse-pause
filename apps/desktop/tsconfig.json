{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pulsepause/domain-models": ["../../packages/domain-models/src"],
      "@pulsepause/shared-contracts": ["../../packages/shared-contracts/src"],
      "@pulsepause/design-system": ["../../packages/design-system/src"]
    }
  },
  "include": ["src/**/*"]
}
