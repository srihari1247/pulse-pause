{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pulsepause/domain-models": ["../../packages/domain-models/src/index.ts"],
      "@pulsepause/shared-contracts": ["../../packages/shared-contracts/src/index.ts"],
      "@pulsepause/design-system": ["../../packages/design-system/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
